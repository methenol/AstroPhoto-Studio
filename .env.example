# Copy to .env and edit.  Paths are on the host.

# which service `docker compose up` starts: nvidia (GPU) by default;
# `docker compose --profile cpu up` overrides it for the CPU-only image
COMPOSE_PROFILES=nvidia

# session folders, mounted read-only at /data/images
IMAGES_DIR=./images
# optional second read-only folder, mounted at /data/library (e.g. the whole NAS share)
# LIBRARY_DIR=/mnt/Astro_Photographs
# caches, stacks, tool licences/models and exports, read-write at /data/output (HOME=/data/output/.home)
OUTPUT_DIR=./output
PORT=8000

# user the server runs as (id -u / id -g).  Default: whoever owns OUTPUT_DIR, else 1000:1000
# PUID=1000
# PGID=1000

# NVIDIA profile only:
# GPU_COUNT=1

# both profiles:
# ASTROPHOTO_CALIB=/data/images/Dwarf/CALI_FRAME
# SHM_SIZE=8gb
# BUILD_NETWORK=default      # build on Docker's default network instead of the host's

# StarNet2: "yes" = I accept the StarNet2 licence (https://www.starnetastro.com) and the image downloads the
# official CLI from download.starnetastro.com at build time. Empty = the app offers the download at run time.
# STARNET_ACCEPT_LICENSE=yes

# RC-Astro CLI: put the installer you downloaded from rc-astro.com at vendor/rc-astro-cli-<ver>-linux-x64.sh
# before building (vendor/ is gitignored).  Activate it in the web UI (Tools panel); the licence is stored
# in OUTPUT_DIR/.home and is tied to the fixed container hostname "astrophoto-studio".

# optional ImageMM restoration (multi-frame, Sukurdeep et al. 2025; deconv_method = imagemm in the web UI):
# off (default) = no torch in the image, ImageMM falls back to BlurXTerminator / Siril RL;
# cuda = install torch with CUDA 12.8 wheels (~7 GB larger image; NVIDIA profile);
# cpu  = install the CPU wheels (~0.3 GB; ImageMM then takes hours on a full field).  Needs a rebuild:
#   IMAGEMM=cuda docker compose up -d --build
# IMAGEMM=off

# read the subs from a local copy while a job runs (true / false)
LOCAL_COPY=false
# LOCAL_DIR=/data/output/.local_copy
