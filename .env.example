# Copy to .env and edit.  Paths are on the host.

# which service `docker compose up` starts: nvidia (GPU) by default;
# `docker compose --profile cpu up` overrides it for the CPU-only image
COMPOSE_PROFILES=nvidia

# session folders, mounted read-only at /data/images
IMAGES_DIR=./images
# caches, stacks and exports, read-write at /data/output
OUTPUT_DIR=./output
PORT=8000

# user the server runs as (id -u / id -g).  Default: whoever owns OUTPUT_DIR, else 1000:1000
# PUID=1000
# PGID=1000

# NVIDIA profile only:
# TORCH_INDEX=https://download.pytorch.org/whl/cu126
# GPU_COUNT=1
# ASTROPHOTO_DEVICE=cuda:1

# both profiles:
# ASTROPHOTO_CALIB=/data/images/Dwarf/CALI_FRAME
# SHM_SIZE=8gb

# read the subs from a local copy while a job runs (true / false): the copy folder is cleared, the
# dataset's light frames are copied into it, every stage reads them from there instead of the
# images folder (a NAS: each stage reads every sub again), and the copy is deleted when the job ends.
# Needs free space for one dataset's subs.  LOCAL_DIR: the folder inside the container
# (default /data/output/.local_copy, on the output volume).
LOCAL_COPY=false
# LOCAL_DIR=/data/output/.local_copy
